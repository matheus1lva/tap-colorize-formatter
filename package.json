{
  "name": "tapcolorize-formatter",
  "version": "1.0.2",
  "description": "Colorize TAP results.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "bin": {
    "tap-colorize": "./bin/tap-colorize.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --outDir dist",
    "dev": "tsup --watch",
    "test": "bun ./test/all.ts",
    "test:fmt": "bun ./test/all.ts | bun ./src/cli.ts",
    "example": "bun ./examples/demo.js | bun ./src/cli.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build && bun run test"
  },
  "keywords": [
    "tap",
    "tap13",
    "formatter",
    "pretty",
    "test",
    "reporter",
    "spec",
    "cli"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "22.13.0",
    "brittle": "4.1.0",
    "tsup": "8.3.6",
    "typescript": "5.7.3"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.0.0"
  }
}